{
    "enabled": {
        "type": "bool",
        "description": "总开关",
        "hint": "开启后Bot会主动找人聊天。关闭后所有功能暂停，但已有数据会保留。",
        "obvious_hint": true,
        "default": true
    },
    "timezone_offset": {
        "type": "string",
        "description": "主动消息时区（UTC±N）",
        "hint": "默认 UTC+8。主动消息的所有时间判定（安静时段、问候、每日额度、作息画像、状态页时间）都按这个钟走，不再看 AstrBot 主机时区——宿主跑在 UTC 容器里也不会把凌晨当成下午。填 auto 才回到旧行为：有 Humanoid Core 就用她所在城市的时区，没有就用本机时间。面板下拉只有整点档；半小时/45 分档（如 UTC+5:30）请直接改配置文件写 UTC+5:30，插件认这种写法。",
        "obvious_hint": true,
        "default": "UTC+8",
        "options": [
            "auto",
            "UTC-12",
            "UTC-11",
            "UTC-10",
            "UTC-9",
            "UTC-8",
            "UTC-7",
            "UTC-6",
            "UTC-5",
            "UTC-4",
            "UTC-3",
            "UTC-2",
            "UTC-1",
            "UTC+0",
            "UTC+1",
            "UTC+2",
            "UTC+3",
            "UTC+4",
            "UTC+5",
            "UTC+6",
            "UTC+7",
            "UTC+8",
            "UTC+9",
            "UTC+10",
            "UTC+11",
            "UTC+12",
            "UTC+13",
            "UTC+14"
        ]
    },
    "mode": {
        "type": "string",
        "description": "运行模式",
        "hint": "auto：自动探测并联动 Humanoid Core；standalone：完全不读 Core。与私聊/群聊无关（那是 private_only）",
        "obvious_hint": true,
        "options": [
            "auto",
            "standalone"
        ],
        "default": "auto"
    },
    "proactive_provider_ids": {
        "description": "【模型】主动消息专用模型（脑子/思考好的）",
        "hint": "留空（默认）= 不指定专供，跟着当前会话的模型走，装上就能说话。想让她用会思考的模型，在这里按顺序选 provider：本插件所有模型调用（1:1 主动、群聊心流、破冰、起话头）都按顺序试，第一个能用的即止。配了却一个都取不到时：默认回退跟随会话模型并打一次性 warning；打开 strict_proactive_provider 才坚持「本轮不主动开口，等下一轮」。",
        "type": "list",
        "items": {
            "type": "string"
        },
        "_special": "select_providers",
        "default": []
    },
    "strict_proactive_provider": {
        "description": "【模型】配了专供模型却取不到时坚持不发",
        "hint": "默认关：配了主动消息专用模型却一个都解析不到时，回退跟随当前会话的模型并打一次性 warning（每次恢复窗口只提示一次，不会刷屏）。打开后：本轮不主动开口，等下一轮，绝不退默认模型（弱模型写出来的主动消息比不发更糟）。",
        "type": "bool",
        "default": false,
        "collapsed": true
    },
    "activity_level": {
        "type": "int",
        "description": "活跃度（10-90）",
        "hint": "她有多爱主动说话",
        "obvious_hint": true,
        "default": 75,
        "min": 10,
        "max": 90,
        "slider": {
            "min": 10,
            "max": 90,
            "step": 1
        }
    },
