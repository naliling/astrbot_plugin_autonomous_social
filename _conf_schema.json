        "type": "float",
        "description": "主动间隔（小时）",
        "hint": "攒够一次主动联系要几小时。注意它进的是速率的分母：实际速率 =(0.25+1.10×在意度)/这个数，而门槛是 2.10，所以 1.5 大约 3~4 小时够一次，4 要 9~11 小时。",
        "obvious_hint": true,
        "default": 1.5,
        "min": 1,
        "max": 96,
        "slider": {
            "min": 1,
            "max": 96,
            "step": 0.5
        }
    },
