        "condition": {
            "allow_private_chat": true
        }
    },
    "reply_window_hours": {
        "type": "int",
        "default": 2,
        "min": 1,
        "max": 48,
        "slider": {
            "min": 1,
            "max": 48,
            "step": 1
        },
        "description": "多久内回话算接住了",
