        "condition": {
            "allow_private_chat": true
        }
    },
    "weekend_boost": {
        "type": "bool",
        "default": true,
        "description": "周末更活跃",
        "hint": "周末念头涨得快一点。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "energy_threshold": {
        "type": "int",
