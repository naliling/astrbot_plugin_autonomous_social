{
  "enabled": {
    "type": "bool",
    "description": "总开关",
    "hint": "开启后Bot会主动找人聊天。关闭后所有功能暂停，但已有数据会保留。",
    "obvious_hint": true,
    "default": true
  },
  "mode": {
    "type": "string",
    "description": "运行模式",
    "hint": "auto：装了 Humanoid Core 就联动作息与身体状态，没装也能独立运行；standalone：完全不读 Core 状态。",
    "obvious_hint": true,
    "default": "auto"
  },
  "activity_level": {
    "type": "int",
    "description": "活跃度（10-90）",
    "hint": "数值越高越爱主动说话。75是平时话比较多、闲不住想找人聊的人。太高会显得话多，太低会显得冷淡。",
    "obvious_hint": true,
    "default": 75,
    "min": 10,
    "max": 90
  },
  "urge_refill_hours": {
    "type": "int",
    "description": "主动间隔（小时）",
    "hint": "攒满一次想说话的念头需要多久。数值越小越频繁。2表示心里一有事就想找人说。",
    "obvious_hint": true,
    "default": 2,
    "min": 1,
    "max": 96
  },
  "recent_talk_minutes": {
    "type": "int",
    "description": "刚聊完静默期（分钟）",
    "hint": "刚聊完多久内不再另起新话题。18分钟避免话刚说完又来一句的机器人感。",
    "obvious_hint": true,
    "default": 18,
    "min": 5,
    "max": 720
  },
  "heartbeat_min_minutes": {
    "type": "int",
    "description": "心跳间隔下限（分钟）",
    "hint": "每一轮结束后随机等这么久再看一眼。默认 8 分钟。想让「沉默 2 分钟就追问」这类分钟级配置真正按分钟生效，就把它调到 1。发不发仍然由念头与冷却决定，心跳快只是让到点被发现的更准。",
    "obvious_hint": true,
    "default": 8,
    "min": 1,
    "max": 60
  },
  "heartbeat_max_minutes": {
    "type": "int",
    "description": "心跳间隔上限（分钟）",
    "hint": "实际间隔在上下界之间随机取，避免节奏精确得像闹钟。不会小于下限。",
    "obvious_hint": true,
    "default": 15,
    "min": 1,
    "max": 120
  },
  "llm_gate": {
    "type": "bool",
    "description": "AI判断该不该发",
    "hint": "开启后模型会自己判断'这句话现在该不该说'，大幅提升拟人度。强烈推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "skip_cooldown_minutes": {
    "type": "int",
    "description": "被拒后冷却（分钟）",
    "hint": "模型决定不说了之后，多久内不再纠结同一个人。10分钟较短，会快速重新考虑。",
    "obvious_hint": true,
    "default": 10,
    "min": 5,
    "max": 480
  },
  "respect_user_rhythm": {
    "type": "bool",
    "description": "顺对方作息",
    "hint": "根据对方平时活跃时段选择时机。关闭后任何时候都可能主动联系（推荐关闭，让她更主动）。",
    "obvious_hint": true,
    "default": false
  },
  "cue_followup": {
    "type": "bool",
    "description": "记住约定时间",
    "hint": "记住对方说的'明天面试''周五交报告'，到时间主动问候。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "followup_enabled": {
    "type": "bool",
    "description": "主动接断掉的话",
    "hint": "聊天中断时主动接一句。对方敷衍就追问，突然没声就问'在吗'。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "probe_after_minutes": {
    "type": "int",
    "description": "敷衍追问间隔（分钟）",
    "hint": "对方回得敷衍时，隔多久追问。2分钟响应快，像在意对话。",
    "obvious_hint": true,
    "default": 2,
    "min": 1,
    "max": 120
  },
  "followup_after_minutes": {
    "type": "int",
    "description": "断话判定间隔（分钟）",
    "hint": "双方都不说话多久算断了。4分钟较敏感，会更快接话。",
    "obvious_hint": true,
    "default": 4,
    "min": 3,
    "max": 240
  },
  "followup_max_minutes": {
    "type": "int",
    "description": "追话最长时限（分钟）",
    "hint": "超过这么久就别追了，隔太久像翻旧账。70分钟是合理上限。",
    "obvious_hint": true,
    "default": 70,
    "min": 15,
    "max": 720
  },
  "followup_cooldown_minutes": {
    "type": "int",
    "description": "追话冷却（分钟）",
    "hint": "两次追话之间的最短间隔。30分钟防止连续追问过于频繁。",
    "obvious_hint": true,
    "default": 30,
    "min": 5,
    "max": 720
  },
  "loop_enabled": {
    "type": "bool",
    "description": "主动问后续",
    "hint": "对方提过但没说结果的事（面试、体检），过几小时主动问'后来怎么样'。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "loop_min_hours": {
    "type": "float",
    "description": "回访最短间隔（小时）",
    "hint": "至少隔多久再问。推荐4小时。",
    "obvious_hint": true,
    "default": 2.5,
    "min": 1.0,
    "max": 24.0
  },
  "loop_max_hours": {
    "type": "float",
    "description": "回访最长间隔（小时）",
    "hint": "最迟多久必须问出去，超过就不问了。推荐12小时。",
    "obvious_hint": true,
    "default": 14.0,
    "min": 3.0,
    "max": 48.0
  },
  "closer_enabled": {
    "type": "bool",
    "description": "无人回时自收尾",
    "hint": "主动发的话没人回时，过一阵自己收场（'没事就随口一说'）。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "closer_after_hours": {
    "type": "int",
    "description": "收尾等待时长（小时）",
    "hint": "主动发的话隔多久没人回才收尾。推荐10小时。",
    "obvious_hint": true,
    "default": 8,
    "min": 2,
    "max": 72
  },
  "track_own_replies": {
    "type": "bool",
    "description": "记住自己说过的话",
    "hint": "开启后Bot知道自己上一句说了什么，追问才能接上。强烈推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "use_core_clock": {
    "type": "bool",
    "description": "按角色时区计时",
    "hint": "按角色所在城市的时间算（需要Humanoid Core）。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "user_cooldown_minutes": {
    "type": "int",
    "description": "单人联系冷却（分钟）",
    "hint": "同一个人两次被主动联系的最短间隔。30分钟是防刷屏护栏，真正节奏由念头决定。",
    "obvious_hint": true,
    "default": 30,
    "min": 10,
    "max": 2880
  },
  "max_sends_per_round": {
    "type": "int",
    "description": "每轮最多联系几人",
    "hint": "一轮心跳（8-15分钟）最多主动联系几个不同的人。推荐2-3个。",
    "obvious_hint": true,
    "default": 3,
    "min": 1,
    "max": 10
  },
  "quiet_start": {
    "type": "int",
    "description": "安静时段开始（小时）",
    "hint": "这段时间几乎不主动说话。推荐23点（晚上11点）。",
    "obvious_hint": true,
    "default": 23,
    "min": 0,
    "max": 23
  },
  "quiet_end": {
    "type": "int",
    "description": "安静时段结束（小时）",
    "hint": "安静时段结束时间。推荐7点（早上7点）。",
    "obvious_hint": true,
    "default": 7,
    "min": 0,
    "max": 23
  },
  "private_only": {
    "type": "bool",
    "description": "只主动私聊",
    "hint": "开启后只主动私聊，不在群里主动说话。推荐开启（群聊分寸更难把握）。",
    "obvious_hint": true,
    "default": true
  },
  "debug": {
    "type": "bool",
    "description": "输出调试日志",
    "hint": "日志会显示'为什么发/为什么不发'。排查问题时开启，平时建议关闭。",
    "obvious_hint": true,
    "default": false
  },
  "max_message_length": {
    "type": "int",
    "description": "单条消息长度上限（字）",
    "hint": "单条消息最多多少字。推荐100-150字。",
    "obvious_hint": true,
    "default": 120,
    "min": 10,
    "max": 500
  },
  "strip_roleplay_actions": {
    "type": "bool",
    "description": "去除括号动作",
    "hint": "去掉'（轻轻抱你）''*摸摸头*'这类动作描写。推荐开启（更像正常聊天）。",
    "obvious_hint": true,
    "default": true
  },
  "allow_emoji": {
    "type": "bool",
    "description": "保留emoji",
    "hint": "是否保留emoji表情。推荐关闭（每句末尾一个❤️很像AI）。",
    "obvious_hint": true,
    "default": false
  },
  "allow_burst": {
    "type": "bool",
    "description": "连发模式",
    "hint": "一次说话拆成2-3条短句，间隔1-3分钟发。推荐开启（更像真人打字）。",
    "obvious_hint": true,
    "default": true
  },
  "max_burst_parts": {
    "type": "int",
    "description": "连发最多条数",
    "hint": "一次最多拆成几条。推荐2-3条。",
    "obvious_hint": true,
    "default": 3,
    "min": 1,
    "max": 3
  },
  "greeting_enabled": {
    "type": "bool",
    "description": "早晚问候",
    "hint": "到了时间主动说早安/晚安。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "greeting_morning_start": {
    "type": "int",
    "description": "早安开始时间（小时）",
    "hint": "早安窗口开始。推荐7-8点。",
    "obvious_hint": true,
    "default": 7,
    "min": 0,
    "max": 23
  },
  "greeting_morning_end": {
    "type": "int",
    "description": "早安结束时间（小时）",
    "hint": "早安窗口结束。推荐11点。",
    "obvious_hint": true,
    "default": 11,
    "min": 1,
    "max": 24
  },
  "greeting_night_start": {
    "type": "int",
    "description": "晚安开始时间（小时）",
    "hint": "晚安窗口开始。推荐21点（晚上9点）。",
    "obvious_hint": true,
    "default": 21,
    "min": 0,
    "max": 23
  },
  "greeting_night_end": {
    "type": "int",
    "description": "晚安结束时间（小时）",
    "hint": "晚安窗口结束。推荐24点（午夜）。",
    "obvious_hint": true,
    "default": 24,
    "min": 1,
    "max": 24
  },
  "group_flow_enabled": {
    "type": "bool",
    "description": "群聊主动接话",
    "hint": "Bot在群里说过话后，会继续关注群聊并主动接话（无需@）。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "group_icebreak_enabled": {
    "type": "bool",
    "description": "群聊冷场破冰",
    "hint": "群太久没人说话时，主动抛个话题。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "group_ref_lib_enabled": {
    "type": "bool",
    "description": "群聊风格学习",
    "hint": "学习群里的说话风格，让接话更自然。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "group_store_message_text": {
    "type": "bool",
    "description": "存储群聊消息",
    "hint": "是否保存群友发言作为参考。关闭后更隐私，但风格学习会失效。",
    "obvious_hint": true,
    "default": true
  },
  "flow_window_minutes": {
    "type": "int",
    "description": "群聊关注窗口（分钟）",
    "hint": "Bot说话后关注群聊多久。推荐10分钟。",
    "obvious_hint": true,
    "default": 8,
    "min": 1,
    "max": 60
  },
  "flow_min_gap_seconds": {
    "type": "int",
    "description": "群聊插话间隔（秒）",
    "hint": "两次插话最少间隔多久。推荐60秒。",
    "obvious_hint": true,
    "default": 45,
    "min": 10,
    "max": 600
  },
  "flow_max_replies_per_window": {
    "type": "int",
    "description": "窗口内最多接几次",
    "hint": "一个关注窗口内最多接几次话。推荐3次。",
    "obvious_hint": true,
    "default": 3,
    "min": 1,
    "max": 10
  },
  "flow_hourly_cap": {
    "type": "int",
    "description": "群聊每小时上限",
    "hint": "每群每小时最多插话几次。推荐5次。",
    "obvious_hint": true,
    "default": 6,
    "min": 1,
    "max": 60
  },
  "flow_ignored_exit": {
    "type": "int",
    "description": "连续被忽略后退出",
    "hint": "连续插话几次都没人理就停下来。推荐2次。",
    "obvious_hint": true,
    "default": 2,
    "min": 1,
    "max": 10
  },
  "group_idle_hours": {
    "type": "float",
    "description": "破冰冷场时长（小时）",
    "hint": "群安静多久才考虑破冰。推荐8小时。",
    "obvious_hint": true,
    "default": 6.0,
    "min": 1.0,
    "max": 240.0
  },
  "icebreak_daily_cap": {
    "type": "int",
    "description": "每日破冰上限",
    "hint": "每群每天最多破冰几次。推荐1-2次。",
    "obvious_hint": true,
    "default": 2,
    "min": 1,
    "max": 10
  },
  "group_stale_days": {
    "type": "int",
    "description": "群退出判定天数",
    "hint": "多少天没在群里见到消息就当已退群。推荐5天。",
    "obvious_hint": true,
    "default": 3,
    "min": 1,
    "max": 90
  },
  "group_ref_sample_size": {
    "type": "int",
    "description": "群聊参考库容量",
    "hint": "每群保留多少条群友发言样本。推荐30条。",
    "obvious_hint": true,
    "default": 30,
    "min": 5,
    "max": 200
  },
  "group_ref_prompt_count": {
    "type": "int",
    "description": "风格样本抽取数",
    "hint": "生成时参考多少条群友发言。推荐5-8条。",
    "obvious_hint": true,
    "default": 8,
    "min": 0,
    "max": 30
  },
  "topic_memory_count": {
    "type": "int",
    "description": "话题记忆数量",
    "hint": "记住最近多少个聊天话题。推荐5个。设0关闭话题记忆。",
    "obvious_hint": true,
    "default": 5,
    "min": 0,
    "max": 20
  },
  "context_inject_count": {
    "type": "int",
    "description": "上下文条数",
    "hint": "生成时参考多少条最近的双向对话。私聊会把 AstrBot 会话历史与插件自己的对话账本合并，群聊读近期发言；都包含 bot 自己说过的话。默认 10 条，条数越多，本次生成调用消耗的 token 越多。设 0 则不注入历史上下文。",
    "obvious_hint": true,
    "default": 10,
    "min": 0,
    "max": 50
  },
  "weekend_boost": {
    "type": "bool",
    "description": "周末更活跃",
    "hint": "周末让念头涨得快一些（×1.25）。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "energy_threshold": {
    "type": "int",
    "description": "精力阈值",
    "hint": "精力低于此值时念头几乎不涨。推荐15。",
    "obvious_hint": true,
    "default": 15,
    "min": 0,
    "max": 100
  },
  "social_energy_threshold": {
    "type": "int",
    "description": "社交能量阈值",
    "hint": "社交能量低于此值时不想说话。推荐20。",
    "obvious_hint": true,
    "default": 20,
    "min": 0,
    "max": 100
  },
  "adaptive_reply_rate": {
    "type": "bool",
    "description": "按回复率调节",
    "hint": "对方不接话会慢慢减少主动频率。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "reply_window_hours": {
    "type": "int",
    "description": "回复判定窗口（小时）",
    "hint": "主动消息发出后多久内对方回话才算'接住了'。推荐3小时。",
    "obvious_hint": true,
    "default": 2,
    "min": 1,
    "max": 48
  },
  "owner_only_commands": {
    "type": "bool",
    "description": "指令仅主人可用",
    "hint": "'触发社交''社交状态'等指令是否仅主人可用。推荐开启。",
    "obvious_hint": true,
    "default": true
  },
  "allowed_trigger_uids": {
    "type": "list",
    "description": "指令白名单",
    "hint": "除主人外允许谁使用指令（填user_id）。",
    "obvious_hint": true,
    "default": []
  },
  "store_message_text": {
    "type": "bool",
    "description": "存储私聊消息",
    "hint": "是否保存私聊消息正文。关闭后更隐私，但功能会削弱。",
    "obvious_hint": true,
    "default": true
  },
  "user_retention_days": {
    "type": "int",
    "description": "闲置用户清理天数",
    "hint": "多少天没联系的用户会被清理历史数据。推荐45天，设0永不清理。",
    "obvious_hint": true,
    "default": 30,
    "min": 0,
    "max": 3650
  },
  "history_ingest": {
    "type": "bool",
    "description": "导入历史会话",
    "hint": "从AstrBot会话库导入之前聊过的人。推荐开启（装插件后立即能用）。",
    "obvious_hint": true,
    "default": true
  },
  "seed_users": {
    "type": "list",
    "description": "主动认识名单",
    "hint": "即使没聊过也会主动联系的user_id列表。每项一个ID，如：12345",
    "obvious_hint": true,
    "default": []
  },
  "seed_platform": {
    "type": "string",
    "description": "默认平台",
    "hint": "seed_users的默认平台（如aiocqhttp、wechat）。推荐aiocqhttp。",
    "obvious_hint": true,
    "default": "aiocqhttp"
  }
}
