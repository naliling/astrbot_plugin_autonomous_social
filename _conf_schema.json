{
    "enabled": {
        "type": "bool",
        "default": true,
        "description": "总开关",
        "hint": "关掉后她不再主动说话；面板与指令仍可用。"
    },
    "mode": {
        "type": "string",
        "default": "auto",
        "options": [
            "auto",
            "standalone"
        ],
        "description": "运行模式",
        "hint": "auto 自己判断该不该开口；manual 只回话、不主动。"
    },
    "timezone_offset": {
        "type": "string",
        "default": "UTC+8",
        "options": [
            "auto",
            "UTC-12",
            "UTC-11",
            "UTC-10",
            "UTC-9",
            "UTC-8",
            "UTC-7",
            "UTC-6",
            "UTC-5",
            "UTC-4",
            "UTC-3",
            "UTC-2",
            "UTC-1",
            "UTC+0",
            "UTC+1",
            "UTC+2",
            "UTC+3",
            "UTC+4",
            "UTC+5",
            "UTC+6",
            "UTC+7",
            "UTC+8",
            "UTC+9",
            "UTC+10",
            "UTC+11",
            "UTC+12",
            "UTC+13",
            "UTC+14"
        ],
        "description": "主动消息时区",
        "hint": "按这个时区算安静时段、问候和每日额度；auto 跟随本机。"
    },
    "activity_level": {
        "type": "int",
        "default": 75,
        "min": 10,
        "max": 90,
        "slider": {
            "min": 10,
            "max": 90,
            "step": 1
        },
        "description": "活跃度",
        "hint": "越高越容易攒够念头开口。"
    },
    "debug": {
        "type": "bool",
        "default": false,
        "description": "调试日志",
        "hint": "把每一步判断的原因写进日志，排错时用。"
    },
    "allow_private_chat": {
        "type": "bool",
        "default": true,
        "description": "允许私聊",
        "hint": "关掉后私聊里不主动开口，回话不受影响。"
    },
    "allow_group_chat": {
        "type": "bool",
        "default": true,
        "description": "允许群聊",
        "hint": "关掉后群里不主动开口，被点名回话不受影响。"
    },
    "private_only": {
        "type": "bool",
        "default": false,
        "description": "只主动私聊",
        "hint": "开：只找私聊的人说话，不在群里主动开口。与「只主动群聊」互斥，两个都开等于都不主动。"
    },
    "group_only": {
        "type": "bool",
        "default": false,
        "description": "只主动群聊",
        "hint": "开：只在群里主动说话，不主动找私聊的人。回话不受影响。"
    },
    "proactive_provider_ids": {
        "type": "list",
        "default": [],
        "items": {
            "type": "string"
        },
        "_special": "select_providers",
        "description": "主动消息专用模型（见 strict_proactive_provider）",
        "hint": "留空等于跟着当前会话；取不到时默认回退跟随会话。"
    },
    "strict_proactive_provider": {
        "type": "bool",
        "default": false,
        "description": "专供模型取不到就坚持不发",
        "hint": "开：宁可这一轮不发；关：回退到会话默认模型。"
    },
    "planning_enabled": {
        "type": "bool",
        "default": true,
        "description": "先规划再写",
        "hint": "先让模型判断要不要说、说什么，再单独写正文。"
    },
    "draft_review_enabled": {
        "type": "bool",
        "default": false,
        "description": "发前自评",
        "hint": "发之前让模型把这条当话看一遍，不合格就改写或不发。"
    },
    "persona_platform_fallback": {
        "type": "bool",
        "default": false,
        "description": "人格按平台名兜底",
        "hint": "会话没绑人格时，按 umo 前缀（平台名）找同名人格顶替；多个 bot 共用同一平台会串台，默认关。"
    },
    "max_output_tokens_enabled": {
        "type": "bool",
        "default": true,
        "description": "限制输出长度",
        "hint": "按任务类型给输出上限，provider 不支持时自动跳过。"
    },
    "batch_send_concurrency": {
        "type": "int",
        "default": 3,
        "min": 1,
        "max": 10,
        "slider": {
            "min": 1,
            "max": 10,
            "step": 1
        },
        "description": "批量发送并发数",
        "hint": "一轮里同时对几个人的消息做发送，1 等于串行。"
    },
    "urge_refill_hours": {
        "type": "float",
        "default": 1.5,
        "min": 1,
        "max": 96,
        "slider": {
            "min": 1,
            "max": 96,
            "step": 0.5
        },
        "description": "攒够一次主动要几小时",
        "hint": "越小越爱开口。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "recent_talk_minutes": {
        "type": "int",
        "default": 3,
        "min": 3,
        "max": 720,
        "slider": {
            "min": 3,
            "max": 720,
            "step": 3
        },
        "description": "刚聊完的静默期",
        "hint": "刚聊过这么多分钟内不另起话题。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "heartbeat_min_minutes": {
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 60,
        "slider": {
            "min": 1,
            "max": 60,
            "step": 1
        },
        "description": "心跳间隔下限",
        "hint": "两轮检查之间至少等这么久。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "heartbeat_max_minutes": {
        "type": "int",
        "default": 30,
        "min": 1,
        "max": 120,
        "slider": {
            "min": 1,
            "max": 120,
            "step": 2
        },
        "description": "心跳间隔上限",
        "hint": "实际间隔在上下界之间随机取，避免准得像闹钟。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "llm_gate": {
        "type": "bool",
        "default": true,
        "description": "先让模型判断该不该发",
        "hint": "开：发之前先问模型有没有话可说；关：直接写。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "skip_cooldown_minutes": {
        "type": "int",
        "default": 30,
        "min": 5,
        "max": 480,
        "slider": {
            "min": 5,
            "max": 480,
            "step": 10
        },
        "description": "被模型否掉后的冷却",
        "hint": "模型说这次不说，就隔这么久再考虑同一个人。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "gate_energy_floor": {
        "type": "int",
        "default": 20,
        "min": 0,
        "max": 100,
        "slider": {
            "min": 0,
            "max": 100,
            "step": 2
        },
        "description": "精力低于此值不开口",
        "hint": "0 表示不按精力拦。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "respect_user_rhythm": {
        "type": "bool",
        "default": false,
        "description": "顺着对方的作息挑时间",
        "hint": "按对方平时的活跃时段决定要不要发。",
        "condition": {
            "allow_private_chat": true
        }
    },
    "adaptive_reply_rate": {
        "type": "bool",
        "default": true,
        "description": "按回复率自动降温",
